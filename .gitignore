!assets/uploads/**/.gitkeep

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── OS & Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── PHP ───────────────────────────────────────────────────────
vendor/
composer.lock

# ── Temp / Cache ──────────────────────────────────────────────
/tmp/
*.tmp
*.cache

# ── PHP Info (ไฟล์ debug ชั่วคราว) ───────────────────────────
phpinfo.php
test.php
info.php

# ── Binary / Data files (ไม่ใช่ source code) ─────────────────
*.zip
*.tar.gz
*.tar
*.xlsx
*.xls
*.sql
!database/*.sql

# ── Database dumps (production data) ─────────────────────────
hicm_v2025*.sql
*backup*.sql
*dump*.sql

# ── Claude Code local settings ────────────────────────────────
.claude/settings.local.json

# ── Debug / temp scripts ──────────────────────────────────────
scripts/debug_*.txt
scripts/debug_*.json
scripts/auditor_list.txt
