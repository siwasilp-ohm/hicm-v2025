# ── Secrets & Environment ─────────────────────────────────────
.env
.env.local
.env.*.local
/root/.hicm_mysql_root

# ── User Uploads (runtime data, not part of source) ───────────
assets/uploads/avatars/*
assets/uploads/manual_refs/*
assets/uploads/2025/*
assets/uploads/2026/*
assets/uploads/2027/*
assets/uploads/2028/*
