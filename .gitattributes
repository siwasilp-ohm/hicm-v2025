# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# PHP, HTML, JS, CSS → LF
*.php    text eol=lf
*.html   text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env    text eol=lf
*.conf   text eol=lf
.htaccess text eol=lf

# Shell scripts must be LF (executable on Linux)
install.sh text eol=lf

# Binary — no line ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.xlsx   binary
*.xls    binary
